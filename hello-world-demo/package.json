{
  "name": "ecu-layer-hello-world",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build --base ./",
    "start": "electron .",
    "test": "node tests/smoke.cjs && node --test tests/electron.test.cjs",
    "test:three": "tsx --test tests/three.test.ts",
    "test:all": "npm test && npm run test:three && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "electron": "^39.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "tsx": "^4.20.0"
  }
}
